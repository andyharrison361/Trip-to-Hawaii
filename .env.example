# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (starts with sb_secret_). Server only — never share it.
SUPABASE_SECRET_KEY=sb_secret_xxx
